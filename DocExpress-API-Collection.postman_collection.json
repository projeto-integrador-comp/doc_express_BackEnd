    {
      "name": "Attendance",
      "item": [
        {
          "name": "Check-In",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentId\": \"{{student_id}}\",\n  \"date\": \"2026-04-05\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/attendance/check-in",
