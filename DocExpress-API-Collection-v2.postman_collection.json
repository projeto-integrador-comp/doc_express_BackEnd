{
  "info": {
    "_postman_id": "docexpress-api-collection-v2",
    "name": "DocExpress Creche API - CRUD Completo",
    "description": "API completa para gerenciamento de creche - turmas, alunos e presença",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "1. Login (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@docexpress.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": ["{{base_url}}"],
              "path": ["login"]
            },
            "description": "✅ Faça login e copie o token para a variável 'token'"
          },
          "response": []
        }
      ]
    },
    {
      "name": "👥 Users (Admin Only)",
      "item": [
        {
          "name": "1. Create Teacher",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Maria Silva\",\n  \"email\": \"maria.silva@escola.com\",\n  \"password\": \"senha123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/users/create-teacher",
              "host": ["{{base_url}}"],
              "path": ["users", "create-teacher"]
            },
            "description": "✅ Cria um novo professor. Copie o ID retornado para a variável 'teacher_id'"
          },
          "response": []
        },
        {
          "name": "2. Create Monitor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"João Santos\",\n  \"email\": \"joao.santos@escola.com\",\n  \"password\": \"senha123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/users/create-monitor",
              "host": ["{{base_url}}"],
              "path": ["users", "create-monitor"]
            },
            "description": "✅ Cria um novo monitor. Copie o ID retornado para a variável 'monitor_id'"
          },
          "response": []
        },
        {
          "name": "3. List All Users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/users",
              "host": ["{{base_url}}"],
              "path": ["users"]
            },
            "description": "Lista todos os usuários (admin, professores, monitores)"
          },
          "response": []
        }
      ]
    },
    {
      "name": "🏫 Classrooms (Turmas) - CRUD",
      "item": [
        {
          "name": "1. Create Classroom",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Turma A - Maternal\",\n  \"teacherId\": \"{{teacher_id}}\",\n  \"monitorIds\": [\"{{monitor_id}}\"]\n}"
            },
            "url": {
              "raw": "{{base_url}}/classrooms",
              "host": ["{{base_url}}"],
              "path": ["classrooms"]
            },
            "description": "✅ Cria uma nova turma com professor e monitores. Copie o ID da resposta para 'classroom_id'"
          },
          "response": []
        },
        {
          "name": "2. List All Classrooms",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/classrooms",
              "host": ["{{base_url}}"],
              "path": ["classrooms"]
            },
            "description": "Lista todas as turmas com seus professores, monitores e alunos"
          },
          "response": []
        },
        {
          "name": "3. Get Classroom by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/classrooms/{{classroom_id}}",
              "host": ["{{base_url}}"],
              "path": ["classrooms", "{{classroom_id}}"]
            },
            "description": "Obtém detalhes de uma turma específica"
          },
          "response": []
        },
        {
          "name": "4. Update Classroom",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Turma A - Maternal (Atualizada)\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/classrooms/{{classroom_id}}",
              "host": ["{{base_url}}"],
              "path": ["classrooms", "{{classroom_id}}"]
            },
            "description": "Atualiza informações da turma"
          },
          "response": []
        },
        {
          "name": "5. Delete Classroom",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/classrooms/{{classroom_id}}",
              "host": ["{{base_url}}"],
              "path": ["classrooms", "{{classroom_id}}"]
            },
            "description": "Deleta uma turma (apenas admin)"
          },
          "response": []
        }
      ]
    },
    {
      "name": "👨‍🎓 Students (Alunos) - CRUD",
      "item": [
        {
          "name": "1. Create Student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"João Silva\",\n  \"classroomId\": \"{{classroom_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/students",
              "host": ["{{base_url}}"],
              "path": ["students"]
            },
            "description": "✅ Cria um novo aluno em uma turma. Copie o ID retornado para 'student_id'"
          },
          "response": []
