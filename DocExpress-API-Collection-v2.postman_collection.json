                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/students/classroom/{{classroom_id}}",
              "host": ["{{base_url}}"],
              "path": ["students", "classroom", "{{classroom_id}}"]
            },
            "description": "Lista todos os alunos de uma turma específica"
          },
          "response": []
        },
        {
          "name": "4. Get Student by ID",
          "request": {
            "method": "GET",
            "header": [
