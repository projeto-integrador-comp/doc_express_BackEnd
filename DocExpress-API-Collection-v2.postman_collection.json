              }
            ],
            "url": {
              "raw": "{{base_url}}/students",
              "host": ["{{base_url}}"],
              "path": ["students"]
            },
            "description": "Lista todos os alunos de todas as turmas"
          },
          "response": []
        },
        {
          "name": "3. List Students by Classroom",
          "request": {
            "method": "GET",
