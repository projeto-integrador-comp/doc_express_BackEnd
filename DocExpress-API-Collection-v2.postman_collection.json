      "value": "",
      "type": "string",
      "description": "JWT token obtido após fazer login. Cole aqui após fazer login."
    },
    {
      "key": "classroom_id",
      "value": "",
      "type": "string",
      "description": "ID da turma criada"
    },
    {
      "key": "student_id",
      "value": "",
      "type": "string",
      "description": "ID do aluno criado"
    },
    {
      "key": "teacher_id",
      "value": "",
      "type": "string",
      "description": "ID do professor criado"
    },
    {
      "key": "monitor_id",
      "value": "",
      "type": "string",
