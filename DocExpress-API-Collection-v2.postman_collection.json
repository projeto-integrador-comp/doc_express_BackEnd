        {
          "name": "6. Delete Student",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/students/{{student_id}}",
              "host": ["{{base_url}}"],
              "path": ["students", "{{student_id}}"]
            },
            "description": "Deleta um aluno"
          },
          "response": []
        }
      ]
    },
    {
      "name": "📋 Attendance (Presença) - CRUD",
      "item": [
        {
          "name": "1. Check-In (Entrada)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentId\": \"{{student_id}}\",\n  \"date\": \"2026-04-05\",\n  \"observation\": \"Chegou 15 minutos atrasado\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/attendance/check-in",
              "host": ["{{base_url}}"],
              "path": ["attendance", "check-in"]
            },
            "description": "✅ Registra o horário de entrada (check-in) de um aluno. Formato: YYYY-MM-DD. Campo observation é opcional - pode registrar atrasos, observações especiais, etc."
          },
          "response": []
        },
        {
          "name": "2. Check-Out (Saída)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentId\": \"{{student_id}}\",\n  \"date\": \"2026-04-05\",\n  \"observation\": \"Saída antecipada - aluno se machucou / Dor / Febre - responsável acionado\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/attendance/check-out",
              "host": ["{{base_url}}"],
              "path": ["attendance", "check-out"]
            },
            "description": "✅ Registra o horário de saída (check-out) de um aluno. Campo observation é opcional - registre motivos como: saída antecipada, machucado, dor, febre, ausência sem aviso prévio, etc."
          },
          "response": []
        },
        {
          "name": "3. Get All Attendance by Student",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/attendance/student/{{student_id}}",
              "host": ["{{base_url}}"],
              "path": ["attendance", "student", "{{student_id}}"]
            },
            "description": "Lista histórico completo de presença de um aluno"
          },
          "response": []
        },
        {
          "name": "4. Get Attendance by Classroom (Daily Record)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/attendance/classroom/{{classroom_id}}?date=2026-04-05",
              "host": ["{{base_url}}"],
              "path": ["attendance", "classroom", "{{classroom_id}}"],
              "query": [
                {
                  "key": "date",
                  "value": "2026-04-05",
                  "description": "Data no formato YYYY-MM-DD"
                }
              ]
            },
            "description": "✅ Obtém a chamada/presença de TODOS os alunos de uma turma em um dia específico. Perfeito para visualizar a chamada do dia!"
          },
          "response": []
        }
      ]
    }
  ],
